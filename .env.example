# ponytail: Supabase dashboard > Connect dialog (URL, publishable key) or Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ponytail: server-only, never prefix with NEXT_PUBLIC_ and never commit
SUPABASE_SECRET_KEY=

# ponytail: used for auth redirects; http://localhost:3000 locally, Vercel domain in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ponytail: one-time admin bootstrap script only; remove the password after first run
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ponytail: optional, only if migrations run via psql instead of the Supabase SQL editor/CLI
DATABASE_URL=
